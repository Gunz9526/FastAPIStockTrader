# Copy to .env; keys and webhook belong in .secrets/ (see README).
DB_HOST=db
DB_PORT=5432
DB_NAME=trader
DB_USER=trader
CAPITAL_LIMIT=100000
DAILY_LOSS_LIMIT=0.015
TRADE_RISK=0.0025
GROSS_EXPOSURE_LIMIT=0.60
SYMBOL_EXPOSURE_LIMIT=0.15
MAX_POSITIONS=4
MAX_DRAWDOWN=0.10
DATA_DIR=/app/data
ARTIFACT_DIR=/app/artifacts
REPORT_DIR=/app/reports
TRAINING_THREADS=2
# Automatic startup still requires keys, a validated model, reconciliation and fresh IEX data.
AUTO_START=true
