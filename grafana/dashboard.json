        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT execution_time AS time, SUM(COALESCE(realized_pl, 0)) OVER (ORDER BY execution_time) AS cumulative_pnl FROM trade_logs WHERE action = 'SELL' AND realized_pl IS NOT NULL ORDER BY execution_time",
          "refId": "A"
        }
      ],
      "title": "Cumulative P&L",
      "type": "timeseries"
    },
